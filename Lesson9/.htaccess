DirectoryIndex formajax.php index.php index.html

RewriteEngine On
RewriteBase /phplessons/Lesson9/

# Map clean URLs to your existing PHP files
RewriteRule ^addstudents/?$ formajax.php [L,QSA]
RewriteRule ^students/?$ viewbydiv.php [L,QSA]

# Redirect direct visits to the old file names to the new clean URLs
RewriteCond %{THE_REQUEST} \s/phplessons/Lesson9/formajax\.php[\s?] [NC]
RewriteRule ^formajax\.php$ addstudents [R=301,L]

RewriteCond %{THE_REQUEST} \s/phplessons/Lesson9/viewbydiv\.php[\s?] [NC]
RewriteRule ^viewbydiv\.php$ students [R=301,L]